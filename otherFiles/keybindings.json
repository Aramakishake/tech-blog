// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
{
  "key": "ctrl+f1",
  "command": "editor.action.insertSnippet",
  "args": {
    "snippet": "# ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}(${1|日,月,火,水,木,金,土|}) \n## ${2:やること}\n- [ ] \n- [ ] \n## ${3:やったこと}\n- \n- \n## ${4:わかったこと}\n- \n- \n## ${5:明日やること}\n- [ ] \n- [ ] \n## ${6:所感}\n- \n- \n"
  },
  "when": "editorTextFocus"
}
]