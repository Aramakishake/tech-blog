// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
{
  "key": "ctrl+f1",
  "command": "editor.action.insertSnippet",
  "args": {
    "snippet": "# ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}($CURRENT_DAY_NAME_SHORT) \n## ${1:やること}\n- [ ] \n- [ ] \n## ${2:やったこと}\n- \n- \n## ${3:わかったこと}\n- \n- \n## ${4:明日やること}\n- [ ] \n- [ ] \n## ${5:所感}\n- \n- \n"
  },
  "when": "editorTextFocus"
}
]